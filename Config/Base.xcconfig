// 全員共通のビルド設定。プロジェクトの Debug / Release の両方に、このファイルを割り当てる（docs/setup.md）。

// 個人ごとの値の既定値。Local.xcconfig があれば、下の #include? で上書きされる。
// Local.xcconfig が無くても、シミュレータ向けのビルドは通るようにしておく。
BUNDLE_ID_PREFIX = com.example.unset
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX).kouiunodeiindayo

// iPhone のみ・iOS 26 以上（docs/adr/0004-min-ios-and-tools.md）
// 画面の向き（縦のみ）は project.pbxproj 側に持たせている。ここに書いても Xcode が開くたびにターゲットへ書き戻し、差分が出続けるため
IPHONEOS_DEPLOYMENT_TARGET = 26.0
TARGETED_DEVICE_FAMILY = 1

// カメラを使う理由の文言（文言の正は docs/screen-design.md のカメラの項）
INFOPLIST_KEY_NSCameraUsageDescription = ご飯の写真を撮って記録するために、カメラを使います。

// アプリを明るい表示に固定する。ダーク用の色が未定のため（配色は Kouiunodeiindayo/Design/Theme.swift）
INFOPLIST_KEY_UIUserInterfaceStyle = Light

// ホーム画面のアイコンの下に出る名前。ここで変える（Xcode の General タブで編集すると project.pbxproj に書き戻され、二重になる）
INFOPLIST_KEY_CFBundleDisplayName = いいんだよ

// 独自の暗号化をしていないという申告。無いと App Store Connect へのアップロードのたびに質問される
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO

// 起動画面（Kouiunodeiindayo/Resources/LaunchTitleV2.storyboard。絵は Assets.xcassets/LaunchTitleV2）。
// OS は起動画面を名前ごとに覚える（キャッシュする）ので、絵や配置を変えたときは、storyboard と絵の名前の数字を上げる（V3、V4…）。そうしないと、前の絵が一瞬出る
// project.pbxproj 側の INFOPLIST_KEY_UILaunchScreen_Generation（画像なしの自動生成）は NO にしてある。YES に戻すと、この storyboard とぶつかる
INFOPLIST_KEY_UILaunchStoryboardName = LaunchTitleV2
