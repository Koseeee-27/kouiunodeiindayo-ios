{
  "name": "kouiunodeiindayo-suggest",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "check:suggest": "wrangler deploy --dry-run --outdir .check && node scripts/check-suggest.mjs",
    "check:search": "wrangler deploy --dry-run --outdir .check && node scripts/check-search.mjs"
  },
  "devDependencies": {
    "typescript": "^5",
    "wrangler": "^4"
  }
}
